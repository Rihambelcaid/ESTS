                    <button onclick="switchSection('demandes')" class="nav-btn text-gray-600 hover:text-est-blue font-semibold px-3 py-2 rounded-lg hover:bg-gray-100 transition flex items-center">
                        <i class="fas fa-file-invoice mr-1.5"></i> Demandes
