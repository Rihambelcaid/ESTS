                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-gray-100 pb-4 mb-6 gap-4">
                        <div class="flex items-center space-x-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-est-blue to-est-teal text-white rounded-2xl flex items-center justify-center font-bold text-xl shadow-md" id="dash-avatar">
                                RB
                            </div>
                            <div>
                                <div class="flex items-center space-x-2">
                                    <h2 class="text-xl font-bold text-gray-900" id="dash-student-name">Riham Belcaid</h2>
                                    <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-0.5 rounded-full flex items-center">
                                        <i class="fas fa-check-circle mr-1"></i> Inscrit (2025/2026)
                                    </span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">
