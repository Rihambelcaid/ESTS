                        <path d="M60 18 L68 35 L86 38 L73 51 L76 69 L60 60 L44 69 L47 51 L34 38 L52 35 Z" fill="#ffffff"/>
                    </svg>
                </div>
                
                <div class="max-w-7xl mx-auto relative z-10">
                    <div class="max-w-3xl">
                        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md border border-white/20 px-3 py-1 rounded-full text-xs font-semibold text-est-teal mb-4">
