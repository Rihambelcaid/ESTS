                        </div>
                        <button onclick="requireAuthAction(() => openDocumentModal('Relevé de Notes'))" class="w-full py-2.5 bg-gray-50 hover:bg-amber-500 hover:text-white text-amber-600 font-semibold text-sm rounded-xl border border-gray-200 transition">
                            Demander le relevé
                        </button>
                    </div>
                </div>
            </div>
        </section>

