    <div id="suivi-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <button onclick="toggleModal('suivi-modal')" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xl"></i>
            </button>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Suivi de Demande</h3>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Code de suivi (Ex: #EST-8842)</label>
                    <div class="flex space-x-2">
                        <input type="text" id="tracking-input" placeholder="EST-..." class="w-full p-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-est-teal focus:outline-none">
                        <button onclick="searchTracking()" class="px-4 py-2 bg-est-teal text-white rounded-lg font-semibold text-sm hover:bg-teal-700">
                            Vérifier
                        </button>
                    </div>
                </div>

                <div id="tracking-result" class="hidden p-4 bg-gray-50 border border-gray-200 rounded-xl mt-4">
                    <div class="flex items-center space-x-2 mb-2">
                        <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-ping"></span>
                        <span class="font-bold text-sm text-gray-800" id="result-status">Traitée & Prête</span>
                    </div>
                    <p class="text-xs text-gray-600" id="result-details">Votre document a été validé électroniquement par la scolarité de l'EST Salé.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION SYSTEM -->
    <div id="toast" class="fixed bottom-5 right-5 bg-est-dark text-white px-5 py-3.5 rounded-xl shadow-2xl z-50 hidden flex items-center space-x-3 border border-gray-700">
        <i class="fas fa-check-circle text-est-teal text-lg"></i>
        <span id="toast-message" class="text-sm font-semibold">Opération effectuée avec succès !</span>
    </div>

    <!-- SCRIPT DE GESTION COMPLETE (PERSISTENCE LOCALSTORAGE) -->
    <script>
        // État utilisateur par défaut (Session enregistrée dans localStorage)
        let currentUser = JSON.parse(localStorage.getItem('ests_user')) || null;

        // Historique des demandes par défaut
        let userRequests = JSON.parse(localStorage.getItem('ests_requests')) || [
            { id: '#EST-8842', doc: 'Attestation de Scolarité', date: '10/11/2026', status: 'Validé', ready: true },
            { id: '#EST-7621', doc: 'Convention de Stage (Capgemini)', date: '04/11/2026', status: 'En cours', ready: false }
        ];

        // Démarrage de la page
        window.onload = function() {
            updateUI();
            renderRequests();
        };

        // Mise à jour globale de l'interface selon l'état de connexion
        function updateUI() {
            const authHeader = document.getElementById('auth-header-container');
            const loginBtn = document.getElementById('btn-login-trigger');
            const profileWidget = document.getElementById('user-profile-widget');
            const studentDashboard = document.getElementById('student-dashboard-card');
            const publicStats = document.getElementById('public-stats-bar');
            const heroAction = document.getElementById('hero-action-container');
            const mobileUserActions = document.getElementById('mobile-user-actions');

            if (currentUser) {
                // Utilisateur Connecté
                loginBtn.classList.add('hidden');
                profileWidget.classList.remove('hidden');
                studentDashboard.classList.remove('hidden');

                // Initiales
                const names = currentUser.name.split(' ');
                const initials = names.map(n => n[0]).join('').toUpperCase();
                document.getElementById('widget-initials').innerText = initials;
                document.getElementById('widget-name').innerText = currentUser.name;
                document.getElementById('widget-email').innerText = currentUser.email;

                // Remplir le Dashboard Étudiant
                document.getElementById('dash-avatar').innerText = initials;
                document.getElementById('dash-student-name').innerText = currentUser.name;
                document.getElementById('dash-student-email').innerText = currentUser.email;
                document.getElementById('dash-student-cne').innerText = currentUser.cne || 'G13409821';
                document.getElementById('dash-student-filiere').innerText = currentUser.filiere || 'DUT - Marketing Digital (S3)';

                // Boutons Hero
                heroAction.innerHTML = `
                    <button onclick="switchSection('demandes')" class="bg-est-teal hover:bg-teal-600 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition flex items-center">
                        <i class="fas fa-file-invoice mr-2"></i> Faire une Demande
                    </button>
                    <button onclick="switchSection('emplois')" class="bg-white/10 hover:bg-white/20 text-white font-semibold py-3 px-6 rounded-xl backdrop-blur-md transition flex items-center border border-white/20">
                        <i class="fas fa-calendar-alt mr-2"></i> Voir Mon Emploi du Temps
                    </button>
                `;

                // Mobile
                mobileUserActions.innerHTML = `
                    <div class="px-3 py-2 text-xs font-bold text-gray-700">${currentUser.name} (${currentUser.email})</div>
                    <button onclick="logoutUser()" class="w-full text-left px-3 py-2 text-xs text-red-600 font-bold">
                        <i class="fas fa-power-off mr-2"></i> Déconnexion
                    </button>
                `;
            } else {
                // Utilisateur Non Connecté
                loginBtn.classList.remove('hidden');
                profileWidget.classList.add('hidden');
                studentDashboard.classList.add('hidden');

                heroAction.innerHTML = `
                    <button onclick="toggleModal('login-modal')" class="bg-est-teal hover:bg-teal-600 text-white font-bold py-3.5 px-7 rounded-xl shadow-lg transition flex items-center text-sm">
                        <i class="fas fa-user-lock mr-2"></i> Se Connecter avec email @um5.ac.ma
                    </button>
                `;

                mobileUserActions.innerHTML = `
                    <button onclick="toggleModal('login-modal'); toggleMobileMenu()" class="w-full bg-est-blue text-white py-2.5 rounded-xl font-bold text-center block text-sm">
                        <i class="fas fa-sign-in-alt mr-1"></i> Connexion UM5
                    </button>
                `;
            }
        }

        // Soumission Formulaire Authentification (@um5.ac.ma)
        function handleLoginSubmit(event) {
            event.preventDefault();
            const emailInput = document.getElementById('login-email').value.trim();
            const errorMsg = document.getElementById('email-validation-msg');

            // Validation stricte du domaine institutionnel @um5.ac.ma
            if (!emailInput.toLowerCase().endsWith('@um5.ac.ma')) {
                errorMsg.classList.remove('hidden');
                return;
            }

            errorMsg.classList.add('hidden');

            // Extraire le nom à partir de l'email si ce n'est pas Riham
            let name = "Riham Belcaid";
            let filiere = "DUT - Marketing Digital (S3)";
            let cne = "G13409821";

            if (!emailInput.toLowerCase().includes('riham')) {
                const parts = emailInput.split('@')[0].split('_');
                name = parts.map(p => p.charAt(0).toUpperCase() + p.slice(1)).join(' ');
                filiere = "DUT - Génie Informatique (S3)";
                cne = "K" + Math.floor(10000000 + Math.random() * 90000000);
            }

            currentUser = {
                email: emailInput,
                name: name,
                filiere: filiere,
                cne: cne
            };

            // Sauvegarder dans localStorage pour GitHub Pages
            localStorage.setItem('ests_user', JSON.stringify(currentUser));

            toggleModal('login-modal');
            updateUI();
            showToast('Bienvenue ' + currentUser.name + ' ! Connexion réussie.');
        }

        // Déconnexion
        function logoutUser() {
            currentUser = null;
            localStorage.removeItem('ests_user');
            updateUI();
            showToast('Vous vous êtes déconnecté.');
        }

        // Action nécessitant la connexion
        function requireAuthAction(actionCallback) {
            if (!currentUser) {
                toggleModal('login-modal');
                showToast('Veuillez vous connecter avec votre email @um5.ac.ma');
            } else {
                actionCallback();
            }
        }

        // Rendu de la liste des demandes dans le LocalStorage
        function renderRequests() {
            const container = document.getElementById('recent-requests-list');
            container.innerHTML = '';

            userRequests.forEach(req => {
                const item = document.createElement('div');
                item.className = 'p-3.5 bg-gray-50 rounded-xl border border-gray-200';
                item.innerHTML = `
                    <div class="flex justify-between items-center text-xs text-gray-500 mb-1">
                        <span class="font-mono font-bold">${req.id}</span>
                        <span class="${req.ready ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} font-bold px-2 py-0.5 rounded text-[10px]">
                            ${req.status}
                        </span>
                    </div>
                    <h4 class="font-bold text-xs text-gray-900">${req.doc}</h4>
                    <div class="flex justify-between items-center mt-2">
                        <span class="text-[10px] text-gray-400">Demandé le ${req.date}</span>
                        ${req.ready ? `
                            <button onclick="downloadMockPDF('${req.doc}.pdf')" class="text-[11px] bg-est-teal text-white px-2 py-1 rounded hover:bg-teal-700 transition">
                                <i class="fas fa-download mr-1"></i> PDF
                            </button>
                        ` : ''}
                    </div>
                `;
                container.appendChild(item);
            });
        }

        // Modal Formulaire Document
        function openDocumentModal(docTitle) {
            document.getElementById('modal-doc-title').innerText = 'Demander : ' + docTitle;
            document.getElementById('doc-student-name').value = currentUser ? currentUser.name : '';
            document.getElementById('doc-student-email').value = currentUser ? currentUser.email : '';
            toggleModal('document-modal');
        }

        // Soumission Demande Document
        function submitDocumentRequest(event) {
            event.preventDefault();
            const docTitle = document.getElementById('modal-doc-title').innerText.replace('Demander : ', '');
            const randomRef = '#EST-' + Math.floor(1000 + Math.random() * 9000);
            const today = new Date().toLocaleDateString('fr-FR');

            const newReq = {
                id: randomRef,
                doc: docTitle,
                date: today,
                status: 'En traitement',
                ready: false
            };

            userRequests.unshift(newReq);
            localStorage.setItem('ests_requests', JSON.stringify(userRequests));

            renderRequests();
            toggleModal('document-modal');
            showToast('Demande ' + randomRef + ' transmise avec succès !');
        }

        // Soumission Réclamation
        function handleReclamationSubmit(event) {
            event.preventDefault();
            const ref = '#REC-' + Math.floor(1000 + Math.random() * 9000);
            event.target.reset();
            showToast('Réclamation transmise. Numéro de suivi : ' + ref);
        }

        // Navigation Sections
        function switchSection(sectionId) {
            const sections = document.querySelectorAll('.content-section');
            sections.forEach(sec => sec.classList.add('hidden'));

            const target = document.getElementById('sec-' + sectionId);
            if (target) {
                target.classList.remove('hidden');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Modal Utility
        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
            }
        }

        // Mobile Menu Utility
        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        // Tracking Simulation
        function searchTracking() {
            const val = document.getElementById('tracking-input').value.trim();
            const resultBox = document.getElementById('tracking-result');
            if (val.length > 0) {
                resultBox.classList.remove('hidden');
                document.getElementById('result-status').innerText = 'Demande ' + val.toUpperCase() + ' : En cours de signature';
            }
        }

        function downloadMockPDF(filename) {
            showToast('Téléchargement du document officiel ' + filename);
        }

        function filterSchedule() {
            showToast('Emploi du temps actualisé.');
        }
    </script>
</body>
</html>
