                                    <i class="fas fa-file-contract"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">Attestation de Scolarité</h3>
                                    <p class="text-xs text-gray-500 mt-1">Valide pour la bourse, le transport et démarches administratives.</p>
                                </div>
                            </div>
