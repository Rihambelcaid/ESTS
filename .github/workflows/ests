                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Étudiant Authentifié (Affiché si connecté) -->
            <div id="student-dashboard-card" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20 hidden">
