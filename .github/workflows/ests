            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        est: {
                            blue: '#003366',
                            teal: '#00A896',
                            light: '#F4F7FA',
                            dark: '#0A192F',
                            gold: '#D4AF37'
                        }
                    }
                }
            }
        }
